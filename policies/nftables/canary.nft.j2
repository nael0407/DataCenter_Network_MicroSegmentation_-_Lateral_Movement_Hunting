#!/usr/sbin/nft -f
# policies/nftables/canary.nft.j2
# Host-based Micro-segmentation: Role Honeypot Decoy (canary1)
# Zona Decoy: 10.10.50.0/24

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # 1. Antarmuka Loopback
        iif "lo" accept

        # 2. Connection Tracking
        ct state established,related accept
        ct state invalid drop

        # 3. Diagnostik ICMP Ping
        ip protocol icmp icmp type echo-request accept

        # 4. Akses Administratif SSH: Hanya dari Bastion SecOps
        ip saddr { 10.10.40.11, 192.168.122.81 } tcp dport 22 accept

        # 5. Port Decoy OpenCanary Aktif (Menerima probe lateral penyerang untuk memicu alert)
        tcp dport { 21, 23, 80, 2222, 3306, 6379, 8080 } accept

        # 6. Default Deny Drop
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy drop;

        # 1. Antarmuka Loopback
        oif "lo" accept

        # 2. Connection Tracking
        ct state established,related accept
        ct state invalid drop

        # 3. Gateway Transit OPNsense (10.10.50.1): ICMP
        ip daddr 10.10.50.1 icmp type echo-request accept

        # 4. Telemetri Syslog Alert ke SecOps (10.10.40.11:1514)
        ip daddr 10.10.40.11 udp dport 1514 accept

        # 5. Default Deny Drop
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }
}
